{
  "header": {
    "blocks": ["header-layout.desktop", "header-layout.mobile"]
  },
  "header.full": {
    "blocks": ["header-layout.desktop", "header-layout.mobile"]
  },
  "header-layout.desktop": {
    "children": [
      "flex-layout.row#topbar",
      "sticky-layout#4-desktop"
    ]
  },

  
  "flex-layout.row#topbar": {
    "props": {
      "blockClass": "header-topbar",
      "horizontalAlign": "center",
      "preventHorizontalStretch": true,
      "preventVerticalStretch": true,
      "fullWidth": true
    },
    "children": [
      "flex-layout.col#topbar"
    ]
  },
  

  "sticky-layout#4-desktop": {
    "props": {
      "blockClass": "sticky-header"
    },
    "children": ["flex-layout.row#4-desktop", "flex-layout.row#5-desktop-menu"]
  },
  "flex-layout.row#4-desktop": {
    "props": {
      "blockClass": ["main-header", "container"],
      "horizontalAlign": "center",
      "verticalAlign": "center",
      "preventHorizontalStretch": true,
      "preventVerticalStretch": true,
      "fullWidth": true
    },
    "children": [
      "flex-layout.col#logo-desktop",
      "flex-layout.col#search-bar-col",
      "login#header-login",
      "image#wishlist-icon",
      "minicart.v2"
    ]
  },
  "flex-layout.col#search-bar-col": {
    "props": {
      "width": "grow",
      "blockClass": "desk-header-col"
    },
    "children": [
      "search-bar#header-search-bar"
    ]
  },

  "search-bar#header-search-bar": {
    "props": {
      "placeholder": "Qual produto você procura?",
      "displayMode": "search-and-clear-buttons"
    }
  },

  "login#header-login": {
    "props": {
      "optionsTitle": "Escolha uma forma de login",
      "emailAndPasswordTitle": "Entrar com e-mail e senha",
      "accessCodeTitle": "Entrar com código de acesso",
      "emailPlaceholder": "Digite seu e-mail",
      "passwordPlaceholder": "Digite sua senha",
      "acessCodePlaceholder": "Digite o código recebido",
      "showPasswordVerificationIntoTooltip": true,
      "showIconProfile": true,
      "iconLabel": "Minha Conta",
      "hideIconLabel": false,
      "labelClasses": ["login-icon", "highlighted"],
      "providerPasswordButtonLabel": "Continuar com senha",
      "identifierPlaceholder": "CPF ou CNPJ",
      "invalidIdentifierError": "Identificador inválido. Tente novamente.",
      "mirrorTooltipToRight": false
    }

  },

  "flex-layout.row#5-desktop-menu": {
    "children": [
      "flex-layout.col#category-menu"
    ],
    "props":{
      "blockClass": "category-menu",
      "horizontalAlign": "center",
      "preventHorizontalStretch": true,
      "preventVerticalStretch": true,
      "fullWidth": true
    }
  },
  "flex-layout.col#logo-desktop": {
    "props": {
      "verticalAlign": "middle"
    },
    "children": ["logo#desktop"]
  },
  "flex-layout.col#category-menu": {
    "props": {
      "verticalAlign": "middle"
    },
    "children": ["vtex.menu@2.x:menu#category-menu"]
  },
  "logo#desktop": {
    "props": {
      "title": "Logo",
      "href": "/",
      "url": "assets/logo_amakha.jpg",
      "width": "108",
      "height": "54"
    }
  },
  "image#wishlist-icon":{
    "props":{
      "src": "assets/wishlist-header2.svg",
      "blockClass": "wishlist-icon",
      "width": "30px",
      "height": "30px",
      "title": "Wishlist",
      "link": {
          "url": "/wishlist",
          "title": "Wishlist" // Optional: title for accessibility
        }
    }
  },
   "link#wishlist_link": {
    "props": {
      "url": "/wishlist",
      "attributeNofollow": false,
      "attributeTitle": "Wishlist",
      "newTab": false
    }
  },
  "header-layout.mobile": {
    "children": ["sticky-layout#1-mobile"]
  },
  "sticky-layout#1-mobile": {
    "children": ["flex-layout.row#1-mobile"]
  },
  "flex-layout.row#1-mobile": {
    "children": [
      "drawer",
      "logo#mobile",
      "login",
      "minicart.v2"
    ],
    "props": {
      "blockClass": "main-header-mobile",
      "preventHorizontalStretch": true,
      "preserveLayoutOnMobile": true,
      "fullWidth": true
    }
  },
 
  "drawer": {
    "children": ["menu#drawer"]
  },

  "menu#drawer": {
    "children": [
      "menu-item#category-apparel",
      "menu-item#category-home",
      "menu-item#more"
    ],
    "props": {
      "orientation": "vertical"
    }
  },

  "logo#mobile": {
    "props": {
      "title": "Logo",
      "href": "/",
      "url": "https://storecomponents.vteximg.com.br/arquivos/store-theme-logo-mobile.png",
      "width": "77.5",
      "height": "27.5"
    }
  }
}
