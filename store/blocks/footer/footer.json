  "flex-layout.row#footer-1-desktop": {
    "children": [
      "flex-layout.col#footer-1-desktop-col-1",
      "flex-layout.col#footer-1-desktop-col-2",
      "flex-layout.col#footer-1-desktop-col-3",
      "flex-layout.col#footer-1-desktop-col-4",
      "flex-layout.col#footer-1-desktop-col-5"
    ],
    "props": {
      "blockClass": "footer-section",
      "paddingTop": 6,
      "paddingBottom": 3
    }
  },

   "flex-layout.col#footer-1-desktop-col-1":{
      "props": {
          "width": "100%",
          "blockClass": ["footer-col", "footer-col-1"],
          "preventVerticalStretch": true,
          "preventHorizontalStretch": true
          
      },
      "children": [
          "image#footer-logo",
          "social-networks",
          "rich-text#footer-description"
      ]
  },

   "flex-layout.col#footer-1-desktop-col-2":{
      "props": {
          "width": "100%",
          "blockClass": ["footer-col", "footer-col-2"],
          "preventVerticalStretch": true,
          "preventHorizontalStretch": true,
          "colSizing": "100%"
      },
      "children": [
          "flex-layout.row#footer-1-desktop-col-2-row-1",
          "flex-layout.row#footer-1-desktop-row-2",
          "flex-layout.row#footer-1-desktop-row-3"
      ]
  },

   "flex-layout.col#footer-1-desktop-col-3":{
      "props": {
          "width": "100%",
          "blockClass": ["footer-col", "footer-col-3"],
          "preventVerticalStretch": true,
          "preventHorizontalStretch": true,
          "colSizing": "100%"
      },
      "children": [
          "flex-layout.row#footer-1-desktop-col-3-row-1"
      ]
  },

   "flex-layout.col#footer-1-desktop-col-4":{
      "props": {
          "width": "100%",
          "blockClass": ["footer-col", "footer-col-4"],
          "preventVerticalStretch": true,
          "preventHorizontalStretch": true,
          "colSizing": "100%"
      },
      "children": [
          "flex-layout.row#footer-1-desktop-col-4-row-1",
          "flex-layout.row#footer-1-desktop-col-4-row-2"
      ]
  },

   "flex-layout.col#footer-1-desktop-col-5":{
      "props": {
          "width": "100%",
          "blockClass": ["footer-col", "footer-col-5"],
          "preventVerticalStretch": true,
          "preventHorizontalStretch": true,
          "colSizing": "100%"
      },
      "children": [
          "flex-layout.row#footer-1-desktop-col-5-row-1"
      ]
  },

