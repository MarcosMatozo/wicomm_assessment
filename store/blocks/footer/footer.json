  "newsletter-form": {
    "children": [
      "newsletter-input-name#name",
      "newsletter-input-email#e-mail",
      "newsletter-submit#submit"
    ]
  },
  "newsletter-input-name#name": {
    "props": {
      "placeholderText": "Nome"
    }
  },
  
  "newsletter-input-email#e-mail": {
    "props": {
      "placeholderText": "Digite seu e-mail"
    }
  },
  
