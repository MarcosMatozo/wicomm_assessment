{

    //Bg Gray Section
    "flex-layout.row#bg-gray-section":{
        "props": {
            "blockClass": ["container", "home-bg-gray-section"],
            "colSizing": "equal"
        },
        "children": [
            "flex-layout.col#bg-gray-section"
        ],
        "title": "Gray Section"
    },

    "flex-layout.col#bg-gray-section":{
        "props": {
            "width": "100%"
        },
        "children": [
            "rich-text#bg-gray-section",
            "flex-layout.row#bg-gray-section-content"
        ]
    },


    //Bg Gray Section Title
    "rich-text#bg-gray-section":{
        "props": {
            "text": "Nossas Causas",
            "blockClass": "shelfTitle",
            "width": "100%"
        },
        "title": "Gray Section Title"
    },

    "flex-layout.row#bg-gray-section-content":{
        "props": {
            "blockClass": ["home-bg-gray-section-content"]
        },
        "children": [
            "flex-layout.col#bg-gray-section-content-1",
            "flex-layout.col#bg-gray-section-content-2",
            "flex-layout.col#bg-gray-section-content-3"
        ]
    },

    "flex-layout.col#bg-gray-section-content-1":{
        "props": {
            "width": "100%"
        },
        "children": [
            "image#bg-gray-section-content-1-image",
            "rich-text#bg-gray-section-content-1-text"
        ]
    },

    "flex-layout.col#bg-gray-section-content-2":{
        "props": {
            "width": "100%"
        },
        "children": [
            "image#bg-gray-section-content-2-image",
            "rich-text#bg-gray-section-content-2-text"
        ]
    },

    "flex-layout.col#bg-gray-section-content-3":{
        "props": {
            "width": "100%"
        },
        "children": [
            "image#bg-gray-section-content-3-image",
            "rich-text#bg-gray-section-content-3-text"
        ]
    },

    "flex-layout.row#static-instagram":{
        "props": {
            "blockClass": ["static-instagram", "container"],
            "colSizing": "auto"
        },
        "children": [
            "flex-layout.col#static-instagram-left",
            "flex-layout.col#static-instagram-right"
        ],
        "title": "Static Instagram"
    },

    "flex-layout.col#static-instagram-left":{
        "props": {
            "width": "25%",
            "blockClass": "static-instagram-left"
        },
        "children": [
            "rich-text#static-instagram-left"
        ]
    },
    "flex-layout.col#static-instagram-right":{
        "props": {
            "width": "75%",
            "blockClass": "static-instagram-right"
        },
        "children": [
            "list-context.image-list#static-instagram-images"
        ]
    },

    "list-context.image-list#static-instagram-images": {
        "children": ["slider-layout#static-instagram-images"],
        "props": {
        "width": 249,
        "height": 249,
        "preload": true,
        "images": [
            {
            "width": "auto",
            "image": "https://storecomponents.vteximg.com.br/arquivos/Class&Style-desktop.png",
            "mobileImage": "https://storecomponents.vteximg.com.br/arquivos/Class&Style-mobile.png"
            },
            {
            "width": "auto",
            "image": "https://storecomponents.vteximg.com.br/arquivos/banner-decoration.png",
            "mobileImage": "https://storecomponents.vteximg.com.br/arquivos/banner-decoration-mobile.png"
            }
        ]
        }
    },

    "slider-layout#static-instagram-images": {
        "props": {
            "itemsPerPage": {
                "desktop": 3,
                "tablet": 2,
                "phone": 1
            },
        "infinite": true,
        "showNavigationArrows": "desktopOnly",
        "showPaginationDots": "never",
        "blockClass": "carousel"
        }
    },



    "rich-text#bg-gray-section-content-1-text": {
        "props": {
            "textAlignment": "CENTER",
            "textPosition": "CENTER",
            "text": ""
        }
    },

    "rich-text#bg-gray-section-content-2-text": {
        "props": {
            "textAlignment": "CENTER",
            "textPosition": "CENTER",
            "text": ""
        }
    },

    "rich-text#static-instagram-left": {
        "props": {
            "textAlignment": "CENTER",
            "textPosition": "CENTER",
            "text": "Fique por dentro das nossas redes sociais @amakhaoficial"
        }
    },
    "rich-text#bg-gray-section-content-3-text": {
        "props": {
            "textAlignment": "CENTER",
            "textPosition": "CENTER",
            "text": ""
        }
    },

    "image#bg-gray-section-content-1-image": {
        "props": {
            "blockClass": "bg-gray-section-content-1-image",
            "title": "Wicomm",
            "link": {
                "url": "/",
                "title": ""
            }
        }
    },

    "image#bg-gray-section-content-2-image": {
        "props": {
            "blockClass": "bg-gray-section-content-2-image",
            "title": "Wicomm",
            "link": {
                "url": "/",
                "title": ""
            }
        }
    },

    "image#bg-gray-section-content-3-image": {
        "props": {
            "blockClass": "bg-gray-section-content-3-image",
            "title": "Wicomm",
            "link": {
                "url": "/",
                "title": ""
            }
        }
    }
}