{
  "store.home": {
    "blocks": [
      "list-context.image-list#demo",
      /* You can make references to blocks defined in other files.
       * For example, `flex-layout.row#deals` is defined in the `deals.json` file. */
      
      //Custom app - Offer Timer
      "offer-timer",
      "flex-layout.row#deals",
      "__fold__",

      // Showcase 1
      "rich-text#shelf-title",
      "flex-layout.row#shelf",
      
      //Banners #1
      "rich-text#title-banner-1",
      "flex-layout.row#banner-1",

      // Showcase 2
      "rich-text#shelf-title2",
      "flex-layout.row#shelf2",

      //Banners #2
      "rich-text#title-banner-2",
      "flex-layout.row#banner-2",

      // Showcase 3
      "rich-text#shelf-title3",
      "flex-layout.row#shelf3",


      "newsletter"
    ]
  },

  "list-context.image-list#demo": {
    "children": ["slider-layout#demo-images"],
    "props": {
      "height": 372,
      "preload": true,
      "images": [
        {
          "width": "auto",
          "image": "https://storecomponents.vteximg.com.br/arquivos/Class&Style-desktop.png",
          "mobileImage": "https://storecomponents.vteximg.com.br/arquivos/Class&Style-mobile.png"
        },
        {
          "width": "auto",
          "image": "https://storecomponents.vteximg.com.br/arquivos/banner-decoration.png",
          "mobileImage": "https://storecomponents.vteximg.com.br/arquivos/banner-decoration-mobile.png"
        }
      ]
    }
  },
  "slider-layout#demo-images": {
    "props": {
      "itemsPerPage": {
        "desktop": 1,
        "tablet": 1,
        "phone": 1
      },
      "infinite": true,
      "showNavigationArrows": "desktopOnly",
      "blockClass": "carousel"
    }
  },

  "rich-text#shelf-title": {
    "props": {
      "text": "Summer",
      "blockClass": "shelfTitle"
    }
  },
  "rich-text#shelf-title2": {
    "props": {
      "text": "Winter",
      "blockClass": "shelfTitle"
    }
  },
  "rich-text#shelf-title3": {
    "props": {
      "text": "Spring",
      "blockClass": "shelfTitle"
    }
  },

  "rich-text#title-banner-1": {
    "props": {
      "text": "Potencialize sua saúde com os nossos lançamentos",
      "blockClass": "shelfTitle"
    }
  },
  "rich-text#title-banner-2": {
    "props": {
      "text": "Desvende o segredo dos cabelos perfeitos com nosso cronograma capilar",
      "blockClass": "shelfTitle"
    }
  },
  "flex-layout.row#shelf": {
    "props":{
      "blockClass": "container"
    },
    "children": ["list-context.product-list#demo1"]
  },
  "flex-layout.row#shelf2": {
    "props":{
      "blockClass": "container"
    },
    "children": ["list-context.product-list#demo2"]
  },
  "flex-layout.row#shelf3": {
    "props":{
      "blockClass": "container"
    },
    "children": ["list-context.product-list#demo3"]
  },


  "flex-layout.row#banner-1": {
    "props":{
      "title": "Banner Promocional da Home",
      "blockClass": ["container", "home-banner-1"],
      "colSizing": "auto"
    },
    "children": ["flex-layout.col#banner-1-col-1", "flex-layout.col#banner-1-col-2"]
  },


  "flex-layout.row#banner-2": {
    "props":{
      "title": "Banner Promocional da Home",
      "blockClass": ["container", "home-banner-2"],
      "colSizing": "auto"
    },
    "children": ["flex-layout.col#banner-2-col-1", "flex-layout.col#banner-2-col-2", "flex-layout.col#banner-2-col-3", "flex-layout.col#banner-2-col-4"]
  },

  "flex-layout.col#banner-1-col-1": {
    "children": [
      "image#banner-1-col-1"
    ],
    "props": {
      "blockClass": "banner-1-col-1",
      "preventVerticalStretch": true
    }
  },
  "flex-layout.col#banner-1-col-2": {
    "props": {
      "blockClass": "banner-1-col-2",
      "preventVerticalStretch": true
    },
    "children": [
      "image#banner-1-col-2-banner-1",
      "image#banner-1-col-2-banner-2"
    ]
  },
  "flex-layout.col#banner-2-col-1": {
    "children": [
      "image#banner-2-col-1-banner-1"
    ],
    "props": {
      "blockClass": "banner-2-col-1",
      "preventVerticalStretch": true
    }
  },
  "flex-layout.col#banner-2-col-2": {
    "children": [
      "image#banner-2-col-2-banner-2"
    ],
    "props": {
      "blockClass": "banner-2-col-2",
      "preventVerticalStretch": true
    }
  },
  "flex-layout.col#banner-2-col-3": {
    "children": [
      "image#banner-2-col-3-banner-3"
    ],
    "props": {
      "blockClass": "textColumn",
      "preventVerticalStretch": true
    }
  },
  
  "flex-layout.col#banner-2-col-4": {
    "children": [
      "image#banner-2-col-4-banner-4"
    ],
    "props": {
      "blockClass": "textColumn",
      "preventVerticalStretch": true
    }
  },

  "image#banner-1-col-1":{
    "props":{
      "blockClass": "banners-1-banners",
      "title": "Wicomm",
      "link": {
          "url": "/",
          "title": ""
        }
    }
  },

  "image#banner-1-col-2-banner-1":{
    "props":{
      "blockClass": "banners-1-banners-2",
      "title": "Wicomm",
      "link": {
          "url": "/",
          "title": ""
        }
    }
  },

  "image#banner-2-col-1-banner-1":{
    "props":{
      "blockClass": "banners-2-banners-1",
      "title": "Wicomm",
      "link": {
          "url": "/",
          "title": ""
        }
    }
  },

  "image#banner-2-col-2-banner-2":{
    "props":{
      "blockClass": "banners-2-banners-2",
      "title": "Wicomm",
      "link": {
          "url": "/",
          "title": ""
        }
    }
  },

  "image#banner-2-col-3-banner-3":{
    "props":{
      "blockClass": "banners-2-banners-3",
      "title": "Wicomm",
      "link": {
          "url": "/",
          "title": ""
        }
    }
  },

  "image#banner-2-col-4-banner-4":{
    "props":{
      "blockClass": "banners-2-banners-4",
      "title": "Wicomm",
      "link": {
          "url": "/",
          "title": ""
        }
    }
  },

  "image#banner-1-col-2-banner-2":{
    "props":{
      "blockClass": "banners-1-banners",
      "title": "Wicomm",
      "link": {
          "url": "/",
          "title": ""
        }
    }
  },



  "list-context.product-list#demo1": {
    "blocks": ["product-summary.shelf"],
    "children": ["slider-layout#demo-products"],
    "props": {
      "orderBy": "OrderByTopSaleDESC"
    }
  },
  "list-context.product-list#demo2": {
    "blocks": ["product-summary.shelf"],
    "children": ["slider-layout#demo-products2"],
    "props": {
      "orderBy": "OrderByTopSaleDESC"
    }
  },
  "list-context.product-list#demo3": {
    "blocks": ["product-summary.shelf"],
    "children": ["slider-layout#demo-products3"],
    "props": {
      "orderBy": "OrderByTopSaleDESC"
    }
  },
  "info-card#home": {
    "props": {
      "id": "info-card-home",
      "isFullModeStyle": false,
      "textPosition": "left",
      "imageUrl": "https://storecomponents.vteximg.com.br/arquivos/banner-infocard2.png",
      "headline": "Clearance Sale",
      "callToActionText": "DISCOVER",
      "callToActionUrl": "/sale/d",
      "blockClass": "info-card-home",
      "textAlignment": "center"
    }
  },
  "slider-layout#demo-products": {
    "props": {
      "itemsPerPage": {
        "desktop": 4,
        "tablet": 3,
        "phone": 1
      },
      "infinite": true,
      "fullWidth": false,
      "blockClass": "shelf"
    }
  },
  "slider-layout#demo-products2": {
    "props": {
      "itemsPerPage": {
        "desktop": 4,
        "tablet": 3,
        "phone": 1
      },
      "infinite": true,
      "fullWidth": false,
      "blockClass": "shelf"
    }
  },
  "slider-layout#demo-products3": {
    "props": {
      "itemsPerPage": {
        "desktop": 4,
        "tablet": 3,
        "phone": 1
      },
      "infinite": true,
      "fullWidth": false,
      "blockClass": "shelf"
    }
  }
}
